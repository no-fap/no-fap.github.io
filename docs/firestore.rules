rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function me(uid) { return request.auth != null && request.auth.uid == uid; }
    function p2(n) { return (n < 10 ? '0' : '') + string(n); }
    function ymd(t) { return string(t.year()) + '-' + p2(t.month()) + '-' + p2(t.day()); }

    match /users/{uid} {
      allow read: if me(uid);
      allow create: if me(uid)
        && request.resource.data.currentStreak == 0 && request.resource.data.highestStreak == 0
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 20
        && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 20))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 900000));
      allow update: if me(uid)
        && (
          // Daily check-in streak update
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['currentStreak','highestStreak','lastLogDate','lastLogStatus','lastLogAt'])
            && request.resource.data.lastLogAt == request.time
            && request.resource.data.lastLogDate in [ymd(request.time - duration.value(1, 'd')), ymd(request.time), ymd(request.time + duration.value(1, 'd'))]
            && request.resource.data.lastLogDate != resource.data.get('lastLogDate', '')
            && existsAfter(/databases/$(db)/documents/users/$(uid)/logs/$(request.resource.data.lastLogDate))
            && request.resource.data.currentStreak in [0, 1, resource.data.currentStreak + 1]
            && request.resource.data.highestStreak == math.max(request.resource.data.currentStreak, resource.data.highestStreak)
          )
          ||
          // Profile & Squad/Arena state customizations
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['nickname','username','avatar','bio','tag','updatedAt','squadId','leftGlobalArena'])
            && (!('nickname' in request.resource.data) || (request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 20))
            && (!('username' in request.resource.data) || (request.resource.data.username is string && request.resource.data.username.size() >= 3 && request.resource.data.username.size() <= 20))
            && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 160))
            && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 900000))
            && (!('tag' in request.resource.data) || request.resource.data.tag is string)
            && (!('leftGlobalArena' in request.resource.data) || request.resource.data.leftGlobalArena == true)
          )
        );

      match /logs/{d} {
        allow read: if me(uid);
        allow create: if me(uid) && d == request.resource.data.date
          && request.resource.data.keys().hasOnly(['date','masturbated','pornHours'])
          && request.resource.data.masturbated is bool
          && request.resource.data.pornHours is number
          && request.resource.data.pornHours >= 0 && request.resource.data.pornHours <= 5.5;
      }

      match /unlocks/{badgeId} {
        allow read: if me(uid);
        allow create, update: if me(uid);
      }

      match /games/{gameId} {
        allow read: if me(uid);
        allow create, update: if me(uid);
      }
    }

    // Public Profiles - accessible to anyone for leaderboard & public warrior URLs
    match /publicProfiles/{uid} {
      allow read: if true;
      allow create, update: if me(uid)
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 20
        && request.resource.data.currentStreak is number
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 900000));
    }

    // Unique Username Registry
    match /usernames/{username} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null && request.resource.data.uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Global Arena Group Chat (Accessible to authenticated users who haven't permanently left)
    match /globalRooms/{roomId}/messages/{msgId} {
      allow read, create, update: if request.auth != null;
    }

    // Accountability Squads (Max 15 members enforced, 1080x1080 avatar up to 900k chars)
    match /squads/{squadId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 15
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 900000));
      allow update: if request.auth != null
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() <= 15
        && (!('avatar' in request.resource.data) || (request.resource.data.avatar is string && request.resource.data.avatar.size() <= 900000));

      match /messages/{msgId} {
        allow read, create, update: if request.auth != null;
      }
    }

    // Instagram-Style Squad Invites & Join Requests
    match /squadRequests/{reqId} {
      allow read, create, update, delete: if request.auth != null;
    }

    // 1-on-1 Direct Messages & Message Requests
    match /dms/{dmId} {
      allow read, create, update, delete: if request.auth != null;

      match /messages/{msgId} {
        allow read, create, update: if request.auth != null;
      }
    }

    // 15 MB Chunked Media Vault (Standard / View Once 1x / View Twice 2x Photos & PDF Documents)
    match /mediaVault/{mediaId} {
      allow read, create, update, delete: if request.auth != null;

      match /chunks/{chunkId} {
        allow read, create: if request.auth != null
          && request.resource.data.data is string
          && request.resource.data.data.size() <= 800000;
      }
    }

    // High scores for 2048
    match /highScores/{id} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // Tic-Tac-Toe multiplayer matches
    match /tttMatches/{id} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }
  }
}
